#!/bin/zsh
# Start the servo calibration page:  ./start   (from atech/port_test)
# Starts control.py unless it is already running, then opens http://localhost:8766.
# control.py runs on the same Python as the `atech` command: `pip install atech` brings
# pyserial (for the board's USB port) with it, and the Flash button runs `atech upload`.
cd "${0:A:h}"
PY=()
if ATECH=$(whence -p atech); then
  shebang=$(head -1 "$ATECH")
  PY=(${=shebang#\#!})                  # e.g. /path/bin/python, or /usr/bin/env python3
fi
if [[ -z $PY || ! -x $PY[1] ]] || ! $PY -c "import serial" 2>/dev/null; then
  echo "The atech command was not found. Install it once with:  pip install atech"
  exit 1
fi
if ! curl -s -o /dev/null http://localhost:8766/; then
  $PY control.py &
  for i in {1..20}; do curl -s -o /dev/null http://localhost:8766/ && break; sleep 0.25; done
fi
open http://localhost:8766
wait
